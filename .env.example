# Manual owner notification channel: none, email, whatsapp, or both.
NOTIFICATION_METHOD=none

# Upstash Redis (replaces Netlify Blobs for enquiry storage on Vercel).
# Create a free Redis database at https://console.upstash.com and copy these values.
# On Vercel, connect the Upstash integration and it auto-injects these vars.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email via Resend. Verify the sender domain with Resend before enabling email.
RESEND_API_KEY=
OWNER_EMAIL=
EMAIL_FROM=

# Official WhatsApp Business Cloud API. The template must be approved by Meta
# and accept one body text parameter containing the enquiry summary.
OWNER_WHATSAPP=+919135839746
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

